/* Level Tag */
.course-level {
  display: inline-block;
  align-self: flex-start;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #80e160;
 
  padding: 4px 10px;
  border-radius: 20px;
  margin-bottom: 12px;
}

/* Course Title */
.course-card h3 {
  font-size: 20px;
  font-weight: 700;
  color: #FAF5FE;
  margin: 0 0 10px 0;
}

/* Course Description */
.course-card .desc {
  font-size: 14px;
  color: #888793;
  line-height: 1.5;
  margin: 0 0 20px 0;
  flex-grow: 1;
}

/* Meta Data (Duration & Lessons) */
.course-meta {
  display: flex;
  gap: 16px;
  font-size: 13px;
  color: #374151;
  font-weight: 500;
  padding-bottom: 16px;
  margin-bottom: 16px;
  border-bottom: 1px solid #272c32;
}

/* Footer (Price & CTA) */


.course-price {
  font-size: 22px;
  font-weight: 800;
  color: #f9fbff;
}
